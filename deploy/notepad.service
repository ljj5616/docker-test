[Unit]
Description=Simple Node.js Notepad
After=network.target

[Service]
Type=simple
User=notepad
Group=notepad
WorkingDirectory=/opt/notepad/current
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/notepad
ExecStart=/usr/bin/node /opt/notepad/current/src/server.js
Restart=on-failure
RestartSec=3
StateDirectory=notepad
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/notepad

[Install]
WantedBy=multi-user.target
